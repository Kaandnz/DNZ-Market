# Firebase konsolu → Proje ayarları → Genel → "Uygulamalarınız" → Web uygulaması → firebaseConfig
# Bu dosyayı .env.local olarak kopyala ve değerleri doldur.
# Boş bırakırsan uygulama yerelde Firebase Emulator'a (demo-dnz) bağlanır.
VITE_FB_API_KEY=
# <proje-id>.web.app ya da <proje-id>.firebaseapp.com
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
VITE_FB_MESSAGING_SENDER_ID=
